// ============================================================================
// Workspace AI - Prisma Schema (SQLite — Desktop Edition)
// ============================================================================
// This schema is functionally identical to schema.prisma but adapted for
// SQLite compatibility:
//   - No @db.* type annotations (SQLite has no type system)
//   - String[] fields → String (JSON-encoded arrays)
//   - No @db.JsonB (SQLite stores JSON as TEXT)
//   - UUIDs stored as plain String (SQLite has no UUID type)
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client-desktop"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Users -------------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  settings  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agents         Agent[]
  teams          Team[]
  tasks          Task[]
  organizations  Organization[]
  projectFiles   ProjectFile[]
  scheduledTasks ScheduledTask[]
  skills             Skill[]
  integrationConnections UserIntegration[]
  chatSessions       ChatSession[]
  feedback           Feedback[]

  @@map("users")
}

// --- Organizations -----------------------------------------------------------

model Organization {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  departments Department[]

  @@unique([userId, name])
  @@index([userId])
  @@map("organizations")
}

// --- Departments -------------------------------------------------------------

model Department {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

// --- Agents ------------------------------------------------------------------

model Agent {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  teamId        String?  @map("team_id")
  name          String
  role          String
  specialty     String   @default("[]")
  status        String   @default("idle")
  isMainAgent   Boolean  @default(false) @map("is_main_agent")
  contextId     String?  @map("context_id")
  currentTaskId String?  @map("current_task_id")
  capabilities   String   @default("[]")
  personality    String?
  modelProvider  String   @default("anthropic") @map("model_provider")
  modelName      String?  @map("model_name")
  createdAt      DateTime @default(now()) @map("created_at")
  lastActive     DateTime @default(now()) @map("last_active")
  lastSyncAt    DateTime? @map("last_sync_at")
  stats         String   @default("{\"tasksCompleted\":0,\"messagesProcessed\":0,\"uptimeSeconds\":0,\"successRate\":100}")

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team?             @relation("TeamAgents", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeams        Team[]            @relation("TeamLead")
  createdTasks    Task[]            @relation("TaskCreator")
  taskAssignments TaskAssignment[]
  sentMessages    Message[]         @relation("MessageSender")
  recipientOf     MessageRecipient[] @relation("AgentRecipient")
  permissions     Permission[]
  auditLogs       AuditLog[]
  context         AgentContext?
  projectFiles    ProjectFile[]
  memories        AgentMemory[]
  scheduledTasks  ScheduledTask[]
  agentSkills     AgentSkill[]

  @@unique([userId, name])
  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@map("agents")
}

// --- Teams -------------------------------------------------------------------

model Team {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  departmentId  String?  @map("department_id")
  name          String
  description   String?
  goal          String?
  leadAgentId   String?  @map("lead_agent_id")
  sharedContext String?  @map("shared_context")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadAgent  Agent?            @relation("TeamLead", fields: [leadAgentId], references: [id], onDelete: SetNull)
  agents     Agent[]           @relation("TeamAgents")
  tasks      Task[]
  messages   MessageRecipient[] @relation("TeamRecipient")

  @@map("teams")
}

// --- Tasks -------------------------------------------------------------------

model Task {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  teamId          String?  @map("team_id")
  title           String
  description     String?
  priority        String   @default("medium")
  status          String   @default("pending")
  createdByAgentId String? @map("created_by_agent_id")
  createdAt       DateTime @default(now()) @map("created_at")
  deadline        DateTime?
  progress        Int      @default(0)
  result          String?
  metadata        String   @default("{}")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   Agent?           @relation("TaskCreator", fields: [createdByAgentId], references: [id])
  assignments TaskAssignment[]

  @@index([teamId])
  @@index([status])
  @@index([userId])
  @@map("tasks")
}

model TaskAssignment {
  taskId     String   @map("task_id")
  agentId    String   @map("agent_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([taskId, agentId])
  @@map("task_assignments")
}

// --- Messages ----------------------------------------------------------------

model Message {
  id          String   @id @default(uuid())
  fromAgentId String?  @map("from_agent_id")
  fromUser    Boolean  @default(false) @map("from_user")
  type        String
  content     String
  metadata    String   @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  sender     Agent?            @relation("MessageSender", fields: [fromAgentId], references: [id], onDelete: SetNull)
  recipients MessageRecipient[]

  @@index([fromAgentId])
  @@index([createdAt(sort: Desc)])
  @@map("messages")
}

model MessageRecipient {
  id        String    @id @default(uuid())
  messageId String    @map("message_id")
  agentId   String?   @map("agent_id")
  teamId    String?   @map("team_id")
  readAt    DateTime? @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation("AgentRecipient", fields: [agentId], references: [id], onDelete: Cascade)
  team    Team?   @relation("TeamRecipient", fields: [teamId], references: [id], onDelete: Cascade)

  @@map("message_recipients")
}

// --- Project Files -----------------------------------------------------------

model ProjectFile {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  agentId   String?  @map("agent_id")
  taskId    String?  @map("task_id")
  path      String
  content   String
  language  String?
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([userId, path])
  @@index([userId])
  @@index([agentId])
  @@map("project_files")
}

// --- Permissions -------------------------------------------------------------

model Permission {
  id             String    @id @default(uuid())
  agentId        String    @map("agent_id")
  permissionType String    @map("permission_type")
  scope          String?
  granted        Boolean   @default(false)
  duration       String?
  expiresAt      DateTime? @map("expires_at")
  grantedAt      DateTime? @map("granted_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, permissionType, scope])
  @@map("permissions")
}

// --- Audit Log ---------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  agentId    String?  @map("agent_id")
  action     String
  toolName   String?  @map("tool_name")
  parameters String?
  result     String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt(sort: Desc)])
  @@map("audit_log")
}

// --- Agent Memory ------------------------------------------------------------

model AgentMemory {
  id         String   @id @default(uuid())
  agentId    String   @map("agent_id")
  content    String
  type       String
  importance Float    @default(5.0)
  embedding  String?
  createdAt  DateTime @default(now()) @map("created_at")
  accessedAt DateTime @default(now()) @map("accessed_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, importance])
  @@index([agentId, createdAt])
  @@map("agent_memories")
}

// --- Scheduled Tasks ---------------------------------------------------------

model ScheduledTask {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  agentId        String?   @map("agent_id")
  title          String
  description    String
  scheduleType   String    @map("schedule_type")
  runAt          DateTime? @map("run_at")
  cronExpression String?   @map("cron_expression")
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  nextRunAt      DateTime? @map("next_run_at")
  jobId          String?   @map("job_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId, enabled])
  @@map("scheduled_tasks")
}

// --- Skills ------------------------------------------------------------------

model Skill {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  name           String   @unique
  description    String
  toolDefinition String   @map("tool_definition")
  handlerType    String   @map("handler_type")
  handlerConfig  String   @map("handler_config")
  isPublic       Boolean  @default(false) @map("is_public")
  createdAt      DateTime @default(now()) @map("created_at")

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentSkills AgentSkill[]

  @@map("skills")
}

model AgentSkill {
  agentId   String   @map("agent_id")
  skillId   String   @map("skill_id")
  enabledAt DateTime @default(now()) @map("enabled_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
  @@map("agent_skills")
}

// --- Integrations ------------------------------------------------------------

model Integration {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String
  category    String
  iconUrl     String?  @map("icon_url")
  website     String?
  authType    String   @map("auth_type")
  authConfig  String   @default("{}") @map("auth_config")
  actions     String   @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userConnections UserIntegration[]

  @@index([category])
  @@index([isActive])
  @@map("integrations")
}

model UserIntegration {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  integrationId   String    @map("integration_id")
  status          String    @default("connected")
  credentials     String    @default("{}")
  config          String    @default("{}")
  connectedAt     DateTime  @default(now()) @map("connected_at")
  lastUsedAt      DateTime? @map("last_used_at")
  expiresAt       DateTime? @map("expires_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  logs        IntegrationLog[]

  @@unique([userId, integrationId])
  @@index([userId])
  @@index([integrationId])
  @@map("user_integrations")
}

model IntegrationLog {
  id                  String   @id @default(uuid())
  userIntegrationId   String   @map("user_integration_id")
  action              String
  status              String
  requestPayload      String?  @map("request_payload")
  responsePayload     String?  @map("response_payload")
  errorMessage        String?  @map("error_message")
  executionTimeMs     Int?     @map("execution_time_ms")
  createdAt           DateTime @default(now()) @map("created_at")

  userIntegration UserIntegration @relation(fields: [userIntegrationId], references: [id], onDelete: Cascade)

  @@index([userIntegrationId, createdAt(sort: Desc)])
  @@map("integration_logs")
}

// --- Agent Context -----------------------------------------------------------

model AgentContext {
  id                  String   @id @default(uuid())
  agentId             String   @unique @map("agent_id")
  conversationHistory String   @default("[]") @map("conversation_history")
  knowledgeBase       String   @default("{}") @map("knowledge_base")
  workingMemory       String   @default("{}") @map("working_memory")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("agent_contexts")
}

// --- Feedback ----------------------------------------------------------------

model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  rating    Int?
  message   String
  status    String   @default("new")
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("feedback")
}

// --- Chat Sessions -----------------------------------------------------------

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  agentId   String?  @map("agent_id")
  name      String   @default("New Chat")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_sessions")
}
