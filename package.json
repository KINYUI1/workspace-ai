{
  "name": "workspace-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent AI orchestration platform",
  "scripts": {
    "dev": "tsx watch backend/src/index.ts",
    "build": "tsc -p backend/tsconfig.json",
    "start": "node backend/dist/index.js",
    "lint": "eslint 'backend/src/**/*.ts' 'shared/**/*.ts' --fix",
    "format": "prettier --write 'backend/src/**/*.ts' 'shared/**/*.ts'",
    "test": "jest --config backend/jest.config.js",
    "test:watch": "jest --config backend/jest.config.js --watch",
    "db:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "db:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "db:studio": "prisma studio --schema=backend/prisma/schema.prisma",
    "desktop:db:generate": "prisma generate --schema=backend/prisma/schema.desktop.prisma",
    "desktop:db:push": "DATABASE_URL=file:$HOME/.workspace-ai/workspace-ai.db prisma db push --schema=backend/prisma/schema.desktop.prisma"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "@prisma/client": "^6.3.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.1.0",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dockerode": "^4.0.9",
    "dotenv": "^16.4.1",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "openai": "^6.22.0",
    "playwright": "^1.58.2",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.10",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "prisma": "^6.3.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
